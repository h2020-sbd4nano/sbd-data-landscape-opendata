<https://identifiers.org/aop/591> a sbd:Model ;
  rdfs:label "DBDPE-induced DNA damage increase in liver leading to Non-alcoholic fatty liver disease via liver steatosis and inhibition of regeneration"@en ;
  dc:source <https://h2020-sbd4nano.github.io/sbd-data-aopwiki/models/> ;
  dc:description "This AOP is developed for zebrafish embryos exposed up to 120 hpf at the larval stage and&nbsp;4 month old transgenic female zebrafish or wild-type female zebrafish. It provides novel insight into the toxic mechanisms of DBDPE as well as other emerging pollutants."@en ;
  foaf:page <https://identifiers.org/aop/591> ;
  dcterms:license      <https://creativecommons.org/licenses/by/4.0/> .

