kb:CausalAssertion_43 a sbd:CausalAssertion,
        sbd:resource ;
    enm:CL_0001034 "unknown" ;
    dc:source <https://docs.google.com/spreadsheets/d/18n37M72zQJgfsELIGRj6llEZ44Ao48qGoXWXyPazRD0/edit#gid=760845260> ;
    dcterms:subject [ a "Carbon" ;
            sio:description "unknown" ] ;
    cito:containsAssertionFrom <dx.doi.org/10.1021/tx400385x>,
        <unknown> ;
    sio:SIO_000299 "Many reports have proposed that oxidative stress is one of the mechanisms involved in the toxic effects of carbon nanomaterials.2,24,37,90 The oxidative stress in target cells is caused by the generation of reactive oxygen species (ROS).2 Antioxidant enzymes, such as superoxide dismutase or glutathione per-oxidase, are able to reduce and eliminate ROS. If homeostasis is not achieved, cellular macromolecules, such as proteins, DNA, and lipids, can be damaged.2" ;
    efo:EFO_0000428 "unknown" ;
    sbdbel:cause [ rdfs:label "exposure" ;
            owl:sameAs <unknown> ] ;
    sbdbel:outcome [ rdfs:label "ROS production" ;
            owl:sameAs <1364;257;1115;249;1278;1753;1592>,
                <http://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:26523>,
                <unknown> ] ;
    sbdbel:relationship sbdbel:unknown .

