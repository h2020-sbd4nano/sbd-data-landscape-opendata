kb:CausalAssertion_7 a sbd:CausalAssertion,
        sbd:resource ;
    enm:CL_0001034 "A549 cells" ;
    dc:source <https://docs.google.com/spreadsheets/d/18n37M72zQJgfsELIGRj6llEZ44Ao48qGoXWXyPazRD0/edit#gid=760845260> ;
    dcterms:subject [ a "GO" ;
            sio:description "The thickness of the GO layer is around 0.9 nm according to AFM. m-GO (430 ± 300 nm). The size of l-GO sheets (780 ± 410 nm) is larger than that of s-GO sheets (160 ± 90 nm). In aqueous suspension, the average hydrodynamic diameter (Dh) is 588 nm for m-GO, 556 nm for l-GO, 148 nm for s-GO, according to Nanosizer measurements (Table S1). Three GO samples have very similar FTIR spectra (Fig. S2). The broad absorption at 3400 cm−1 suggests the existence of –COOH and –OH groups. The absorption at 1720 cm−1 corresponds to Cdouble bondO bonds. The oxygen contents based on XPS analysis are 33.1% for l-GO, 37.0% for s-GO and 35.8% for m-GO (Fig. S3). " ;
            owl:sameAs enm:ENM_0000117 ] ;
    cito:containsAssertionFrom <dx.doi.org/10.1021/tx400385x>,
        <https://doi.org/10.1016/j.toxlet.2010.11.016> ;
    sio:SIO_000299 "exposure of A549 cells to GO did not show cell uptake, although size-dependent cytotoxicity and dose-dependent oxidative stress were observed.37" ;
    efo:EFO_0000428 "A549 cells" ;
    sbdbel:cause [ rdfs:label "exposure" ;
            owl:sameAs <unknown> ] ;
    sbdbel:outcome [ rdfs:label "cell uptake (amount)" ;
            owl:sameAs <unknown> ] ;
    sbdbel:relationship sbdbel:DoesNotCorrelate .

kb:CausalAssertion_8 a sbd:CausalAssertion,
        sbd:resource ;
    enm:CL_0001034 "A549 cells" ;
    dc:source <https://docs.google.com/spreadsheets/d/18n37M72zQJgfsELIGRj6llEZ44Ao48qGoXWXyPazRD0/edit#gid=760845260> ;
    dcterms:subject [ a "GO" ;
            sio:description "The thickness of the GO layer is around 0.9 nm according to AFM measurement (Fig. S1). Both large and small sheets are presented in m-GO (430 ± 300 nm). The size of l-GO sheets (780 ± 410 nm) is larger than that of s-GO sheets (160 ± 90 nm). In aqueous suspension, the average hydrodynamic diameter (Dh) is 588 nm for m-GO, 556 nm for l-GO, 148 nm for s-GO, according to Nanosizer measurements (Table S1). Three GO samples have very similar FTIR spectra (Fig. S2). The broad absorption at 3400 cm−1 suggests the existence of –COOH and –OH groups. The absorption at 1720 cm−1 corresponds to Cdouble bondO bonds. The oxygen contents based on XPS analysis are 33.1% for l-GO, 37.0% for s-GO and 35.8% for m-GO (Fig. S3). " ;
            owl:sameAs enm:ENM_0000117 ] ;
    cito:containsAssertionFrom <https://doi.org/10.1016/j.toxlet.2010.11.016>,
        <unknown> ;
    sio:SIO_000299 "The influence of l-GO and m-GO on the viability of A549 cells is tiny. Even at the highest concentration of 200 μg/mL, more than 80% of the cell viability remains. However, s-GO induces more viability loss than l-GO and m-GO. At 200 μg/mL of GO, the cell viability is 67% at 24 h postexposure." ;
    efo:EFO_0000428 "A549 cells" ;
    sbdbel:cause [ rdfs:label "lateral dimension" ;
            owl:sameAs <unknown> ] ;
    sbdbel:outcome [ rdfs:label "cell viability" ;
            owl:sameAs <unknown> ] ;
    sbdbel:relationship sbdbel:NegativelyCorrelates .

kb:CausalAssertion_9 a sbd:CausalAssertion,
        sbd:resource ;
    enm:CL_0001034 "A549 cells" ;
    dc:source <https://docs.google.com/spreadsheets/d/18n37M72zQJgfsELIGRj6llEZ44Ao48qGoXWXyPazRD0/edit#gid=760845260> ;
    dcterms:subject [ a "GO" ;
            sio:description "The thickness of the GO layer is around 0.9 nm according to AFM measurement (Fig. S1). Both large and small sheets are presented in m-GO (430 ± 300 nm). The size of l-GO sheets (780 ± 410 nm) is larger than that of s-GO sheets (160 ± 90 nm). In aqueous suspension, the average hydrodynamic diameter (Dh) is 588 nm for m-GO, 556 nm for l-GO, 148 nm for s-GO, according to Nanosizer measurements (Table S1). Three GO samples have very similar FTIR spectra (Fig. S2). The broad absorption at 3400 cm−1 suggests the existence of –COOH and –OH groups. The absorption at 1720 cm−1 corresponds to Cdouble bondO bonds. The oxygen contents based on XPS analysis are 33.1% for l-GO, 37.0% for s-GO and 35.8% for m-GO (Fig. S3). " ;
            owl:sameAs enm:ENM_0000117 ] ;
    cito:containsAssertionFrom <https://doi.org/10.1016/j.toxlet.2010.11.016>,
        <unknown> ;
    sio:SIO_000299 "GO with higher concentrations induces more ROS. Among the three GO samples, s-GO causes the most serious oxidative stress." ;
    efo:EFO_0000428 "A549 cells" ;
    sbdbel:cause [ rdfs:label "Dose" ;
            owl:sameAs <unknown> ] ;
    sbdbel:outcome [ rdfs:label "ROS production" ;
            owl:sameAs <1364;257;1115;249;1278;1753;1592>,
                <http://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:26523>,
                <unknown> ] ;
    sbdbel:relationship sbdbel:PositivelyCorrelates .

