<https://identifiers.org/aop/330> a sbd:Model ;
  rdfs:label "Excessive reactive oxygen species production leading to mortality (4)"@en ;
  dc:source <https://h2020-sbd4nano.github.io/sbd-data-aopwiki/models/> ;
