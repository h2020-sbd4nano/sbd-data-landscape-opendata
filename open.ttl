  rdfs:label "AOP-Wiki RDF Dashboard"@en ;
  dc:description "A web dashboard for monitoring and analysing the AOP-Wiki RDF knowledge base over time, with entity counts, Key Event component distributions, ontology usage, AOP completeness, network density, and author contributions, plus CSV download of every plot's underlying data."@en ;
  foaf:page <https://aopwiki-dashboard.vhp4safety.nl/> .

<https://vhp4safety.github.io/cloud/service/aopwikiapi> a sbd:Resource ;
