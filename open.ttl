<https://vhp4safety.github.io/cloud/service/aop-builder> a sbd:Resource ;
  dc:source <https://vhp4safety.github.io/cloud/> ;
  rdfs:label "AOP-Builder"@en ;
  dc:description "A tool that supports Adverse Outcome Pathway (AOP) development by extracting key scientific entities and their relationships from literature."@en ;
  foaf:page <https://github.com/VHP4Safety/aop-builder> .

<https://vhp4safety.github.io/cloud/service/aopsuite> a sbd:Resource ;
  dc:source <https://vhp4safety.github.io/cloud/> ;
  rdfs:label "AOP-Suite"@en ;
  dc:description "A web-based tool for building, visualizing and analyzing Adverse Outcome Pathway (AOP) networks."@en ;
  foaf:page <https://aopsuite.cloud.vhp4safety.nl/> .

<https://vhp4safety.github.io/cloud/service/aopwiki> a sbd:Resource ;
  dc:source <https://vhp4safety.github.io/cloud/> ;
  rdfs:label "AOP-Wiki Snorql UI"@en ;
  dc:description "A web-based SPARQL query interface for the AOP-Wiki RDF endpoint, with CodeMirror syntax highlighting, on-the-fly example queries pulled from GitHub, shareable permalinks, and CSV/JSON/XML export."@en ;
  foaf:page <https://aopwiki.rdf.bigcat-bioinformatics.org/> .

<https://vhp4safety.github.io/cloud/service/aopwiki_rdf_dashboard> a sbd:Resource ;
