kb:CausalAssertion_34 a sbd:CausalAssertion,
        sbd:resource ;
    enm:CL_0001034 "MCF-7 cells" ;
    dc:source <https://docs.google.com/spreadsheets/d/18n37M72zQJgfsELIGRj6llEZ44Ao48qGoXWXyPazRD0/edit#gid=760845260> ;
    dcterms:subject [ a "GO" ;
            sio:description "unknown" ;
            owl:sameAs enm:ENM_0000117 ] ;
    cito:containsAssertionFrom <unknown> ;
    sio:SIO_000299 "The cytotoxicity of GO and biogenic rGO was evaluated on human skin fibroblasts (CRL-2522). both GO (synthesized from graphite powder using a modified version of Hummers and Offeman’s method) and biogenic rGO (synthesized by Bacillus marisflavi biomass) exhibited toxicity on MCF-7 cells in a dose-dependent manner (up to a dose >60 μg/mL), thus decreasing the cell viability, increasing the ROS generation, and releasing lactate dehydro-genase.51 Atomic force microcopy revealed that GO exhibit flat sheets with an average thickness of about 0.43 nm, indicating the formation of single-layered GO nanosheets. However, biogenic rGO was found to be thicker (∼4.23 nm), indicating the presence of biomass on the GO surface.51" ;
    efo:EFO_0000428 "MCF-7 cells" ;
    sbdbel:cause [ rdfs:label "Dose" ;
            owl:sameAs <unknown> ] ;
    sbdbel:outcome [ rdfs:label "toxicity" ;
            owl:sameAs npo:NPO_1338,
                <unknown> ] ;
    sbdbel:relationship sbdbel:PositivelyCorrelates .

